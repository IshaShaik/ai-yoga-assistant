MONGODB_URI=mongodb+srv://ishashaik1509_db_user:BPCrtPGDBVzUgaI0@cluster0.spi731a.mongodb.net/?appName=Cluster0
JWT_SECRET=wtGc8DubE006hJRA
CLIENT_URL=http://localhost:5000

# Admin bypass: whoever signs up with this exact code in the "Admin Access
# Code" field (under Sign up -> "Have an admin access code?") gets every
# pose for free, forever — no payment, ever. Change this to your own secret
# value before deploying for real users. Keep it private.
ADMIN_ACCESS_CODE=V1KlXfhDM8UG

# Razorpay — from Dashboard > Settings > API Keys (dashboard.razorpay.com).
# Use Test Mode keys until you've verified the full flow end-to-end, then
# switch to Live Mode keys. RAZORPAY_KEY_ID is not secret and is also sent
# to the browser (required by Razorpay Checkout); RAZORPAY_KEY_SECRET must
# never leave the backend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From Dashboard > Settings > Webhooks, after you add a webhook pointing at
# https://yourdomain.com/api/payment/webhook with the "payment.captured"
# and "payment.failed" events enabled. This is the secret YOU set there,
# used to verify inbound webhooks are genuinely from Razorpay.
RAZORPAY_WEBHOOK_SECRET=

# The ONE place the subscription price is defined. The frontend only ever
# displays this — the backend always uses this value when creating the
# Razorpay order and verifying payments, never a value sent by the browser.
PREMIUM_PRICE=99

# Set to "true" only for local demo/testing — see routes/subscription.js.
DEMO_PAYMENT_VERIFICATION=false